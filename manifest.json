{
  "manifest_version": 3,
  "name": "Brightspace Grades Dashboard",
  "short_name": "BS Grades",
  "version": "1.0.0",
  "description": "See your Brightspace (D2L) grades from every course in one place. Runs locally using your existing login.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Brightspace Grades",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": ["https://brightspace.usc.edu/*"]
}
